# Copia este archivo a .env.local y completa los valores reales.
# Nunca subas .env.local al repositorio ni expongas estas claves al navegador.

# Planificador de carruseles (Claude). Opcional.
ANTHROPIC_API_KEY=

# --- Studio iA: imágenes con iA + carruseles + publicación en redes (/studio) ---
# Guía completa en docs/studio.md. Todas son server-only salvo NEXT_PUBLIC_*.
# Acceso al panel (obligatorias para activar /studio):
STUDIO_PASSWORD=
# Mínimo 32 caracteres aleatorios (firma la sesión y cifra los tokens de redes): openssl rand -hex 32
STUDIO_SECRET=
# API key para n8n, Carrusel Studio y el Dashboard 360 (Authorization: Bearer ...)
STUDIO_API_KEY=
# Secreto para el endpoint /api/studio/cron (publicaciones programadas)
CRON_SECRET=
# Dominio público donde corre la app (Instagram/Facebook descargan las imágenes desde aquí)
STUDIO_PUBLIC_URL=https://studio.tudominio.com

# Generador de imágenes de OpenAI (el mismo motor de ChatGPT)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5
# OPENAI_BASE_URL=https://api.openai.com/v1

# Almacenamiento: "fs" (disco del servidor, VPS/Docker) o "supabase" (Vercel/serverless)
STUDIO_STORAGE=fs
# STUDIO_DATA_DIR=.data/studio
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STUDIO_SUPABASE_BUCKET=studio-media

# Carrusel Studio (app de carruseles) y orígenes extra permitidos por CORS
NEXT_PUBLIC_CARRUSEL_URL=https://carruseles.ia.nom.pe
# STUDIO_CORS_ORIGINS=https://360.ia.nom.pe

# n8n: publicación (LinkedIn, TikTok, X…) y aviso de aprobaciones
N8N_PUBLISH_WEBHOOK_URL=
N8N_APPROVAL_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Meta (Facebook + Instagram) directo — conexión con un clic desde /studio > Conexiones
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v24.0
# Alternativa sin OAuth: token de página de larga duración
# META_PAGE_ID=
# META_PAGE_ACCESS_TOKEN=
# META_IG_USER_ID=
