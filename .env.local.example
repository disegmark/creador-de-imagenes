# Copia este archivo a .env.local y completa los valores reales.
# Nunca subas .env.local al repositorio ni expongas estas claves al navegador.

# Planificador de carruseles (Claude). Opcional.
ANTHROPIC_API_KEY=

# --- Studio iA: imágenes con iA + carruseles + publicación en redes (/studio) ---
# Guía completa en docs/studio.md. Todas son server-only salvo NEXT_PUBLIC_*.
# Secreto del servidor: firma sesiones y enlaces y cifra los tokens de redes.
# Mínimo 32 caracteres aleatorios: openssl rand -hex 32
STUDIO_SECRET=

# Espacios de trabajo: uno por cada sistema/dashboard que use la app.
# Cada espacio tiene su propia cola, conexiones (Meta, n8n) y ajustes; nada se comparte.
#   id           → identificador corto (minúsculas, números, - y _)
#   nombre       → nombre visible
#   password     → entrada manual (opcional si solo se entra desde el Dashboard)
#   sso_secret   → secreto PROPIO para el pase del Dashboard (>= 32 caracteres);
#                  es el mismo valor que SSO_SECRET_IMAGENES en el .env del Dashboard
#   sso_usuario  → usuario que va dentro del pase (por defecto, el id)
#   api_key      → clave para n8n / Carrusel Studio / el Dashboard (Authorization: Bearer)
#   n8n_publish_url, n8n_approval_url, n8n_secret → opcionales; si faltan se usan los globales de abajo
# Todo en una sola línea:
STUDIO_WORKSPACES=[{"id":"ia360","nombre":"iA 360","password":"","sso_secret":"","sso_usuario":"ia360","api_key":""}]
# Id de esta app dentro del pase del Dashboard ({ "app": ... }).
STUDIO_SSO_APP=creador-imagenes
# lax = Dashboard y app en el mismo dominio (*.ia.nom.pe). none = embebida desde otro dominio.
STUDIO_COOKIE_SAMESITE=lax

# Secreto para el endpoint /api/studio/cron (publicaciones programadas de TODOS los espacios)
CRON_SECRET=
# Dominio público donde corre la app (Instagram/Facebook descargan las imágenes desde aquí)
STUDIO_PUBLIC_URL=https://studio.tudominio.com

# Generador de imágenes de OpenAI (el mismo motor de ChatGPT)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5
# OPENAI_BASE_URL=https://api.openai.com/v1

# Almacenamiento: "fs" (disco del servidor, VPS/Docker) o "supabase" (Vercel/serverless)
STUDIO_STORAGE=fs
# STUDIO_DATA_DIR=.data/studio
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STUDIO_SUPABASE_BUCKET=studio-media

# Carrusel Studio (app de carruseles) y orígenes extra permitidos por CORS
NEXT_PUBLIC_CARRUSEL_URL=https://carruseles.ia.nom.pe
# STUDIO_CORS_ORIGINS=https://360.ia.nom.pe

# Imágenes generadas a la vez (el resto espera turno; evita cortes por límite de OpenAI)
STUDIO_IMAGE_CONCURRENCY=3

# n8n global (respaldo si un espacio no define los suyos): publicación y aviso de aprobaciones
N8N_PUBLISH_WEBHOOK_URL=
N8N_APPROVAL_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Meta (Facebook + Instagram) directo — conexión con un clic desde /studio > Conexiones
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v24.0
# Alternativa sin OAuth (solo para un espacio con id "principal"): token de página de larga duración
# META_PAGE_ID=
# META_PAGE_ACCESS_TOKEN=
# META_IG_USER_ID=
